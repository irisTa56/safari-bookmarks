{
  "manifest_version": 3,
  "name": "Safari Bookmarks",
  "version": "1.0",
  "description": "Browse Safari's bookmarks in the side panel, and hand pages to Safari.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["sidePanel", "contextMenus", "nativeMessaging", "favicon"],
  "background": { "service_worker": "background.js" },
  "side_panel": { "default_path": "panel.html" },
  "action": {
    "default_title": "Safari Bookmarks",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  }
}
